{
  "name": "aetheria-rts-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node ./node_modules/typescript/bin/tsc -p tsconfig.electron.json",
    "build:renderer": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "build:electron": "node ./node_modules/typescript/bin/tsc -p tsconfig.electron.json",
    "generate:rts-bindings": "node scripts/generate-aetheria-command-codec.mjs",
    "generate:legacy-rts-bindings": "node scripts/generate-rts-bindings.mjs",
    "check:rts-bindings": "node scripts/generate-aetheria-command-codec.mjs --check",
    "verify:wire-interop": "npm --prefix wire ci && node scripts/verify-rts-wire-interop.mjs",
    "verify:stage7b": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-stage7b-rts-client.ps1",
    "verify:stage7c": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-stage7c-local-runtime.ps1",
    "verify:stage7c:electron": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-stage7c-electron-rts.ps1",
    "verify:stage7d:remote": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-stage7d-remote-cultmesh.ps1",
    "electron": "npm run build && electron .",
    "watch": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "electron": "^42.4.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "@gamecult/eve-browser-lowering": "file:../../Eve/packages/eve-browser-lowering",
    "@gamecult/eve-electron": "file:../../EveElectron",
    "cultcache-ts": "file:../../CultLib/packages/cultcache-ts",
    "cultmesh-ts": "file:../../CultLib/packages/cultmesh-ts",
    "cultnet-ts": "file:../../CultLib/packages/cultnet-ts"
  }
}

<Project>
  <Target Name="VerifyCultLibRevision" BeforeTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="&quot;$(GitExe)&quot; -C &quot;$(CultLibRoot)&quot; rev-parse HEAD"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ResolvedCultLibRevision" />
    </Exec>
    <Error Condition="'$(_ResolvedCultLibRevision)' != '$(CultLibRevision)'"
           Text="CultLibRoot '$(CultLibRoot)' resolves revision '$(_ResolvedCultLibRevision)', but Aetheria admits only '$(CultLibRevision)'." />
    <Exec Command="&quot;$(GitExe)&quot; -C &quot;$(CultLibRoot)&quot; rev-parse &quot;HEAD:unity/org.gamecult.cultlib&quot;"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ResolvedCultLibUnityTree" />
    </Exec>
    <Error Condition="'$(_ResolvedCultLibUnityTree)' != '$(CultLibUnityTree)'"
           Text="CultLib Unity package tree '$(_ResolvedCultLibUnityTree)' does not match admitted tree '$(CultLibUnityTree)'." />
    <Exec Command="&quot;$(GitExe)&quot; -C &quot;$(CultLibRoot)&quot; status --porcelain --untracked-files=all"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_CultLibWorktreeChanges" />
    </Exec>
    <Error Condition="'$(_CultLibWorktreeChanges)' != ''"
           Text="CultLibRoot '$(CultLibRoot)' contains source-affecting worktree changes: $(_CultLibWorktreeChanges)" />
  </Target>

  <Target Name="VerifyEveRevision" BeforeTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="&quot;$(GitExe)&quot; -C &quot;$(EveRoot)&quot; rev-parse HEAD"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ResolvedEveRevision" />
    </Exec>
    <Error Condition="'$(_ResolvedEveRevision)' != '$(EveRevision)'"
           Text="EveRoot '$(EveRoot)' resolves revision '$(_ResolvedEveRevision)', but Aetheria admits only '$(EveRevision)'." />
    <Exec Command="&quot;$(GitExe)&quot; -C &quot;$(EveRoot)&quot; rev-parse &quot;HEAD:packages/org.gamecult.eve.surface&quot;"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ResolvedEveSurfaceTree" />
    </Exec>
    <Error Condition="'$(_ResolvedEveSurfaceTree)' != '$(EveSurfaceTree)'"
           Text="Eve surface package tree '$(_ResolvedEveSurfaceTree)' does not match admitted tree '$(EveSurfaceTree)'." />
    <Exec Command="&quot;$(GitExe)&quot; -C &quot;$(EveRoot)&quot; status --porcelain --untracked-files=all"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_EveWorktreeChanges" />
    </Exec>
    <Error Condition="'$(_EveWorktreeChanges)' != ''"
           Text="EveRoot '$(EveRoot)' contains source-affecting worktree changes: $(_EveWorktreeChanges)" />
  </Target>

  <Target Name="VerifyCultLibReferences" AfterTargets="ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_CultLibReference Include="@(ReferencePath)"
                         Condition="$([System.String]::Copy('%(ReferencePath.Filename)').StartsWith('GameCult.Caching', System.StringComparison.Ordinal))
                                 Or $([System.String]::Copy('%(ReferencePath.Filename)').StartsWith('GameCult.Logging', System.StringComparison.Ordinal))
                                 Or $([System.String]::Copy('%(ReferencePath.Filename)').StartsWith('GameCult.Mesh', System.StringComparison.Ordinal))
                                 Or $([System.String]::Copy('%(ReferencePath.Filename)').StartsWith('GameCult.Networking', System.StringComparison.Ordinal))
                                 Or '%(ReferencePath.Filename)' == 'GameCult.Geometry'
                                 Or '%(ReferencePath.Filename)' == 'CultMath'" />
      <_GameCultMeshReference Include="@(_CultLibReference)"
                              Condition="'%(Filename)%(Extension)' == 'GameCult.Mesh.dll'" />
    </ItemGroup>
    <PropertyGroup>
      <_CultLibRootPrefix>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(CultLibRoot)'))))</_CultLibRootPrefix>
    </PropertyGroup>

    <Error Condition="@(_GameCultMeshReference->Count()) != 1"
           Text="Expected exactly one resolved GameCult.Mesh reference, found @(_GameCultMeshReference->Count()): @(_GameCultMeshReference, ', ')" />
    <Error Condition="$([System.String]::Copy('%(_CultLibReference.FullPath)').StartsWith('$(_CultLibRootPrefix)', System.StringComparison.OrdinalIgnoreCase)) != 'true'"
           Text="CultLib-owned assembly resolved outside CultLibRoot '$(CultLibRoot)': %(_CultLibReference.FullPath)" />

    <GetFileHash Files="@(_GameCultMeshReference)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_GameCultMeshReferenceHash" />
    </GetFileHash>
    <Message Importance="High"
             Text="GameCult.Mesh reference: %(_GameCultMeshReferenceHash.FullPath) SHA256=%(_GameCultMeshReferenceHash.FileHash)" />
  </Target>

  <Target Name="VerifyEveReferences" AfterTargets="ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_EveReference Include="@(ReferencePath)"
                     Condition="'%(ReferencePath.Filename)' == 'GameCult.Eve.Surface'" />
    </ItemGroup>
    <PropertyGroup>
      <_EveRootPrefix>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(EveRoot)'))))</_EveRootPrefix>
    </PropertyGroup>

    <Error Condition="@(_EveReference->Count()) != 1"
           Text="Expected exactly one resolved GameCult.Eve.Surface reference, found @(_EveReference->Count()): @(_EveReference, ', ')" />
    <Error Condition="$([System.String]::Copy('%(_EveReference.FullPath)').StartsWith('$(_EveRootPrefix)', System.StringComparison.OrdinalIgnoreCase)) != 'true'"
           Text="Eve-owned assembly resolved outside EveRoot '$(EveRoot)': %(_EveReference.FullPath)" />
  </Target>
</Project>
